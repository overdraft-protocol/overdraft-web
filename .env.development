# Dev defaults — production builds set per-product values in scripts/build.mjs
VITE_PRODUCT=wallet
VITE_TITLE=Overdraft — MCP Wallet for Agents
VITE_DESCRIPTION=The local MCP wallet for autonomous agents. Private keys in macOS Keychain, Touch ID auth, revocable sessions.

# Cross-product dev URLs are derived from the live host in config.ts (devSiteUrl),
# so there are no per-product VITE_*_URL vars to set or forget here.
