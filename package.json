{
  "name": "overdraft-web",
  "private": true,
  "type": "module",
  "description": "Marketing sites for Overdraft Wallet and Overdraft Market — one codebase, built to per-subdomain static sites.",
  "scripts": {
    "dev": "node scripts/zip-agent-economy-skill.mjs && vite",
    "build": "node scripts/build.mjs all",
    "build:wallet": "node scripts/build.mjs wallet",
    "build:market": "node scripts/build.mjs market",
    "build:economy": "node scripts/build.mjs economy",
    "preview:wallet": "vite preview --outDir dist/wallet --port 5174",
    "preview:market": "vite preview --outDir dist/market --port 5175",
    "preview:economy": "vite preview --outDir dist/economy --port 5176"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
